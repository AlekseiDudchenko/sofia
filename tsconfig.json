{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "rootDir": "src",
    "outDir": "web/js",
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "lib": ["DOM", "ES2022"],
    "types": [],
    "skipLibCheck": true
  },
  "include": ["src/**/*"]
}
